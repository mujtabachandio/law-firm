# Karachi Law Firms — Apache/LiteSpeed config for Hostinger shared hosting.
#
# This file is copied into build/ by the React build and must end up in
# public_html/.htaccess. It does five things:
#   1. Canonicalises the host (https, no www)
#   2. Serves the three sitemap URLs from sitemap.php, generated live
#   3. Routes every non-file URL to index.html so React Router works
#   4. Compresses text responses
#   5. Sets long cache lifetimes for hashed assets, none for index.html

Options -MultiViews

<IfModule mod_rewrite.c>
  RewriteEngine On

  # ---------------------------------------------------------------
  # 1. Canonical host
  # ---------------------------------------------------------------
  # Force HTTPS. The X-Forwarded-Proto check prevents a redirect loop
  # when SSL is terminated upstream.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Strip www. Canonical URLs in the site are all non-www.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # Remove trailing slashes (except on real directories).
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # ---------------------------------------------------------------
  # 2. Dynamic sitemap
  # ---------------------------------------------------------------
  # /sitemap.xml is a sitemap index pointing at two child sitemaps. All three
  # are produced by sitemap.php. Only the posts sitemap queries Sanity, so a
  # post published in the Studio appears without a redeploy.
  #
  # These rules MUST stay above the "serve real files" rule below. The build
  # also ships a static .xml for each of the three URLs as a fallback, and
  # without these rules those stale files would be served instead.
  #
  # If PHP is ever unavailable on this host, comment out all three lines: the
  # static files then take over at the same URLs, carrying the content from
  # the last deploy.
  RewriteRule ^sitemap\.xml$        /sitemap.php?type=index [L]
  RewriteRule ^sitemap-pages\.xml$  /sitemap.php?type=pages [L]
  RewriteRule ^sitemap-posts\.xml$  /sitemap.php?type=posts [L]

  # ---------------------------------------------------------------
  # 3. SPA routing
  # ---------------------------------------------------------------
  # Real files and directories are served as-is...
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # ...everything else is handed to React Router.
  RewriteRule ^ index.html [L]
</IfModule>

# -----------------------------------------------------------------
# 4. Compression
# -----------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/ttf font/otf font/woff font/woff2
</IfModule>

# -----------------------------------------------------------------
# 5. Caching
# -----------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On

  # Filenames under /static/ carry a content hash, so they can be
  # cached indefinitely — a new build produces a new filename.
  <FilesMatch "\.(js|css|woff2?|ttf|otf|eot)$">
    ExpiresDefault "access plus 1 year"
  </FilesMatch>

  # Images are not hashed, so keep them shorter.
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|avif|svg|ico)$">
    ExpiresDefault "access plus 30 days"
  </FilesMatch>

  # index.html must never be cached or visitors keep the old app
  # after a deploy and never load the new JS.
  <FilesMatch "^index\.html$">
    ExpiresDefault "access plus 0 seconds"
  </FilesMatch>

  # Let crawlers pick up changes quickly.
  <FilesMatch "\.(xml|txt|json)$">
    ExpiresDefault "access plus 1 hour"
  </FilesMatch>
</IfModule>

# Cache-Control headers need mod_headers, which is guarded separately so a
# host without it does not 500 on the whole file.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|ttf|otf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# -----------------------------------------------------------------
# Correct MIME types (some shared hosts miss these)
# -----------------------------------------------------------------
<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType image/svg+xml .svg
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>

# Block access to dotfiles that should never be served.
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
