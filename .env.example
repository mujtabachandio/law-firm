# Sanity — public, safe to commit in your own .env
# The production dataset is public, so the site reads it without any token.
REACT_APP_SANITY_PROJECT_ID=91ufe034
REACT_APP_SANITY_DATASET=production

# NOTE: the write token used to publish/migrate content is NOT set here.
# It is only ever passed to the migration script from your shell.
#
#   PowerShell:  $env:SANITY_WRITE_TOKEN = "sk..."; npm run migrate:blog
#   bash:        SANITY_WRITE_TOKEN=sk... npm run migrate:blog

# Where /studio redirects to in a production build.
# Set this after running `npm run studio:deploy`.
REACT_APP_SANITY_STUDIO_URL=https://karachi-law-firms.sanity.studio
